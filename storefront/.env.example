# Salin ke .env.local. Hanya dibaca server (tanpa prefix NEXT_PUBLIC_).
TRYTUIST_API_URL=http://localhost:8080
# Sama dengan salah satu API_KEYS backend
TRYTUIST_API_KEY=dev-local-api-key
# URL storefront ini (cek Origin untuk request POST/PATCH/DELETE)
STOREFRONT_PUBLIC_URL=http://localhost:3001
# Cookie Secure; default aktif di production. false hanya bila diakses lewat http non-localhost.
# COOKIE_SECURE=false
