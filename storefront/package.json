{
  "name": "trytuist-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Web pembeli TryTuist: pilih outlet, pesan menu, bayar, dan lacak pesanan. Lihat ../STOREFRONT_PLAN.md.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
