# Backend Go (trytuist-api). Hanya dibaca di server Next.js, tidak pernah dikirim ke browser.
TRYTUIST_API_URL=http://localhost:8080
# Harus sama dengan salah satu nilai API_KEYS di trytuist-api/.env
TRYTUIST_API_KEY=dev-local-api-key

# Opsional: cookie Secure (default aktif saat production). false hanya untuk akses http lewat IP/LAN.
# COOKIE_SECURE=false
